# Django Settings
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG="False"  # Set to "False" in production
DJANGO_SECRET_KEY=change-me-in-production-use-secrets-generator
DJANGO_SETTINGS_MODULE=config.settings.development

# WARNING: These are development-only credentials.
# NEVER use these in production. Use secure secrets management.
# Database
DATABASE_URL=postgres://dignifi:dignifi_dev_password@localhost:5432/dignifi_dev
POSTGRES_DB=dignifi_dev
POSTGRES_PASSWORD=dignifi_dev_password
POSTGRES_USER=dignifi

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=GENERATE-FERNET-KEY-FOR-PRODUCTION

# District Configuration
DEFAULT_DISTRICT=ilnd

# External Services (TBD)
DOJ_COUNSELING_API_KEY=tbd

# OCR: the hosted model that reads uploaded documents.
# OCR_PROVIDER is "openai" (default) or "gemini". Leave OCR_MODEL empty to use the
# provider's default model (gpt-4o / gemini-2.0-flash); set it to switch models
# without a deploy. Keep comments on their own lines: an inline comment becomes part
# of the value.
OCR_PROVIDER=openai
OCR_MODEL=
OPENAI_API_KEY=your-openai-api-key

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8000/api
